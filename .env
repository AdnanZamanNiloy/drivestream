# ─── Google Drive Video Streamer ──────────────────────────────────────────────
# Full environment reference. Copy values from your own console.

# Optional: Google Drive API v3 key. When set, folder links automatically list
# their video files, and metadata resolution prefers the official Drive API.
# Create one: https://console.cloud.google.com/apis/credentials → "API key" →
# enable "Google Drive API" for the project.
# The app works WITHOUT this key for any file shared "Anyone with the link".
GOOGLE_API_KEY=

# ─── Base (already configured by scaffold) ────────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db
